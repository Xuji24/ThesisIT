# ─── Server ───
PORT=3001
LLM_PROVIDER=openrouter
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ─── OpenAI (server only — never use VITE_ prefix) ───
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── OpenRouter (server only) ───
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free

# ─── Groq (server only) ───
GROQ_API_KEY=your_groq_key_here

# ─── NVIDIA NIM API — DeepSeek R1 + GLM-4 (server only) ───
# Get your key at: https://build.nvidia.com → API Keys
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional model overrides (defaults shown):
# NVIDIA_DEEPSEEK_MODEL=deepseek-ai/deepseek-r1-0528
# NVIDIA_GLM_MODEL=zhipuai/glm-4-9b

# ─── TTS Voice Engine (Mock Defense — server only) ───────────────────────────
# Provider waterfall: ElevenLabs → Google Cloud TTS → Browser SpeechSynthesis
# Leave all blank to use the browser's built-in voice (zero setup).

# Option 1 — ElevenLabs (best quality, neural voices)
# Get key at: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
# Voice ID (default: Rachel — warm professional female)
# Browse voices at: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Option 2 — Google Cloud Text-to-Speech (free tier: 1M chars/month)
# Get key at: https://console.cloud.google.com → APIs → Text-to-Speech → Credentials
GOOGLE_TTS_API_KEY=
# Voice name (default: en-US-Neural2-F — clear educator female)
# See all voices: https://cloud.google.com/text-to-speech/docs/voices
# GOOGLE_TTS_VOICE=en-US-Neural2-F
